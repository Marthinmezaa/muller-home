generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADVISOR
  FRANCHISE_ADMIN
  SUPER_ADMIN
}

enum BillingType {
  ONE_TIME
  MONTHLY
}

enum PurchaseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OperationType {
  SALE
  RENT
}

enum PropertyType {
  HOUSE
  APARTMENT
  LAND
  COMMERCIAL_LOCAL
  OFFICE
}

enum PropertyStatus {
  DRAFT
  PUBLISHED
  PAUSED
  SOLD
  RENTED
}

enum MediaType {
  PHOTO
  VIDEO
}

model User {
  id                String                    @id @default(uuid())
  email             String                    @unique
  passwordHash      String
  fullName          String
  phone             String?
  role              Role                      @default(ADVISOR)
  franchiseId       String?
  franchise         Franchise?                @relation("FranchiseMembers", fields: [franchiseId], references: [id])
  ownedFranchise    Franchise?                @relation("FranchiseOwner")
  invitesCreated    Invite[]
  purchases         PackagePurchase[]         @relation("PurchaseBuyer")
  reviewedPurchases PackagePurchase[]         @relation("PurchaseReviewer")
  properties        Property[]                @relation("PropertyOwner")
  deletionRequests  PropertyDeletionRequest[] @relation("DeletionRequester")
  reviewedDeletions PropertyDeletionRequest[] @relation("DeletionReviewer")
  createdAt         DateTime                  @default(now())

  @@map("users")
}

model Franchise {
  id          String   @id @default(uuid())
  name        String
  ownerUserId String   @unique
  owner       User     @relation("FranchiseOwner", fields: [ownerUserId], references: [id])
  members     User[]   @relation("FranchiseMembers")
  invites     Invite[]
  createdAt   DateTime @default(now())

  @@map("franchises")
}

/// Invitacion a un asesor para sumarse a una franquicia. Se comparte como
/// link fuera del sistema (WhatsApp, etc.) porque todavia no hay proveedor
/// de email configurado.
model Invite {
  id          String    @id @default(uuid())
  token       String    @unique
  franchiseId String
  franchise   Franchise @relation(fields: [franchiseId], references: [id])
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@map("invites")
}

model Package {
  id               String            @id @default(uuid())
  name             String
  billingType      BillingType
  price            Decimal           @db.Decimal(10, 2)
  propertiesQuota  Int
  /// Dato comercial mostrado en el panel; sin tabla de seguimiento ni
  /// descuento automatico en Fase 1 (coordinacion de produccion sigue
  /// siendo el link a WhatsApp).
  productionsQuota Int
  maxAdvisors      Int               @default(1)
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  purchases        PackagePurchase[]

  @@map("packages")
}

model PackagePurchase {
  id              String         @id @default(uuid())
  packageId       String
  package         Package        @relation(fields: [packageId], references: [id])
  buyerId         String
  buyer           User           @relation("PurchaseBuyer", fields: [buyerId], references: [id])
  status          PurchaseStatus @default(PENDING)
  /// Snapshot del cupo del Package al momento de la compra: ediciones
  /// posteriores al catalogo nunca afectan retroactivamente una compra
  /// ya aprobada.
  propertiesQuota Int
  propertiesUsed  Int            @default(0)
  /// Object key en R2, no URL publica: el comprobante es sensible, el
  /// bucket es privado y se sirve via URL prefirmada de corta duracion.
  proofKey        String
  reviewedById    String?
  reviewedBy      User?          @relation("PurchaseReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  createdAt       DateTime       @default(now())

  @@map("package_purchases")
}

model Property {
  id               String                    @id @default(uuid())
  title            String
  description      String
  operationType    OperationType
  propertyType     PropertyType
  price            Decimal                   @db.Decimal(12, 2)
  areaM2           Decimal                   @db.Decimal(8, 2)
  rooms            Int
  bathrooms        Int
  address          String
  city             String
  lat              Decimal                   @db.Decimal(9, 6)
  lng              Decimal                   @db.Decimal(9, 6)
  status           PropertyStatus            @default(DRAFT)
  /// Fecha en la que se marco sold/rented. Junto con la ventana de
  /// retencion (configurable, default 30 dias) define hasta cuando sigue
  /// visible en el buscador publico para seguir generando trafico.
  closedAt         DateTime?
  ownerId          String
  owner            User                      @relation("PropertyOwner", fields: [ownerId], references: [id])
  media            PropertyMedia[]
  deletionRequests PropertyDeletionRequest[]
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@map("properties")
}

model PropertyMedia {
  id         String    @id @default(uuid())
  propertyId String
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  type       MediaType
  /// Object key en R2, mismo bucket/patron que el comprobante de pago.
  key        String
  order      Int       @default(0)
  isCover    Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@map("property_media")
}

/// Baja de una propiedad: el asesor dueno no elimina directo, pide la baja
/// y un franchise_admin/super_admin la aprueba (borra) o rechaza. Mismo
/// flujo pending/approved/rejected que PackagePurchase; el aviso de la
/// solicitud es manual (WhatsApp), no hay notificacion automatica en Fase 1.
model PropertyDeletionRequest {
  id            String         @id @default(uuid())
  propertyId    String
  property      Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User           @relation("DeletionRequester", fields: [requestedById], references: [id])
  status        PurchaseStatus @default(PENDING)
  reviewedById  String?
  reviewedBy    User?          @relation("DeletionReviewer", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  createdAt     DateTime       @default(now())

  @@map("property_deletion_requests")
}
